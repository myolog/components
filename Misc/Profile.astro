---
import { Button } from "../Common";


---

<div class="flex flex-col items-center text-center gap-4">
	<div
		class="w-16 h-16 rounded-full backdrop-blur-xl border flex items-center justify-center shrink-0 bg-linear-to-br from-black/30 to-gray-600/30 border-black/20 text-black dark:from-white/30 dark:to-gray-300/30 dark:border-white/20 dark:text-white overflow-hidden"
	>
		<img
			src="https://avatars.githubusercontent.com/u/57449485?v=4"
			alt="Myogoo"
			width="64"
			height="64"
		/>
	</div>
	<div class="wrap-anywhere">
		<h3 class="mb-2 text-black dark:text-white">묘구</h3>
		<p class="text-sm mb-3 text-black/70 dark:text-white/70">
			이것 저것 언어에 국한 되지 않고 재밌는거 만들어요
		</p>
		<div class="flex gap-2 justify-center mx-2 flex-wrap">
			<Button href="https://github.com/N-Joy-Shadow" title="GitHub" size="small"/>
			<Button href="https://www.curseforge.com/members/njoyshadow/projects" title="CurseForge" size="small"/>
			<Button href="https://solved.ac/profile/njoyshadow" title="Baekjoon" size="small" />
			
		</div>
	</div>
</div>
