---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";

const buttonVariants = cva(
  "flex flex-row items-center border transition-all gap-2",
  {
    variants: {
      variant: {
        outlined: "rounded-full border-black/20 dark:border-white/20 text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/10",
        filled: "rounded-lg backdrop-blur-xl bg-black/10 border-black/20 hover:bg-black/15 text-black/80 hover:text-black dark:bg-white/10 dark:border-white/20 dark:hover:bg-white/15 dark:text-white/80 dark:hover:text-white",
        translucent: "rounded-full backdrop-blur-xl bg-black/10 border-black/20 hover:bg-black/15 dark:bg-white/10 dark:border-white/20 dark:hover:bg-white/15"
      },
      size: {
        medium: "px-4 py-2",
        small: "px-3 py-1 text-xs",
        icon: "p-2",
      },
    },
    defaultVariants: {
      variant: "outlined",
      size: "medium",
    },
  },
);

export interface Props extends HTMLAttributes<"button">, VariantProps<typeof buttonVariants> {
  title?: string
  href?: string
  icon?: string
  iconClass?: string
  newTab?: boolean
}

const {
  variant,
  size,
  class: className,
  href,
  title,
  icon,
  iconClass = "",
  newTab = true,
  ...props
} = Astro.props;

const classes = buttonVariants({ variant, size, className});

const Element = href ? 'a' : 'button';
---

<Element {...props} class:list={[classes,"myo-btn"]} href={href} target={newTab ? "_blank" : "_self"} >
  {icon && <Icon name={icon} class:list={["w-4 h-4", iconClass]}/>}
  {title && (<span>{title}</span>)}
  <slot/>
</Element>